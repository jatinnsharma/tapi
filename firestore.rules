rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /explorers/{uid} {
      allow read: if request.auth != null;

      // The leaderboard ranks by `totalXp`, which the app writes about itself,
      // so the rules limit how fast it can grow. This cannot prove the XP is
      // honest (that needs a server to verify trips: see ACHIEVEMENT_RULES.md),
      // but "set my XP to a million" no longer works.
      //  - A profile starts at 0 XP.
      //  - XP may go down, or up within: 20000 on the very first sync (XP
      //    earned before signing up), then 1000 plus 3000 per day since the
      //    last change.
      //  - A change to XP must carry the server's clock in `xpUpdatedAt`, and
      //    no other write may touch `xpUpdatedAt`.
      function xpGrowthAllowed(old) {
        return !('xpUpdatedAt' in old)
          ? 20000
          : 1000 + 3000 * (request.time.toMillis() - old.xpUpdatedAt.toMillis()) / 86400000;
      }

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.totalXp == 0
        && !('xpUpdatedAt' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == uid && (
        (request.resource.data.get('totalXp', 0) == resource.data.get('totalXp', 0)
          && request.resource.data.get('xpUpdatedAt', null) == resource.data.get('xpUpdatedAt', null))
        ||
        (request.resource.data.xpUpdatedAt == request.time
          && request.resource.data.totalXp is int
          && request.resource.data.totalXp >= 0
          && (request.resource.data.totalXp <= resource.data.get('totalXp', 0)
              || request.resource.data.totalXp - resource.data.get('totalXp', 0) <= xpGrowthAllowed(resource.data)))
      );

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow create: if request.auth != null
        && request.resource.data.requestedBy == request.auth.uid
        && (request.auth.uid == request.resource.data.uidA || request.auth.uid == request.resource.data.uidB)
        && request.resource.data.uidA < request.resource.data.uidB
        && friendshipId == request.resource.data.uidA + '_' + request.resource.data.uidB
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB)
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
    }
    match /activity/{activityId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Owners can delete their own posts (account deletion).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        get(/databases/$(database)/documents/friendships/$(
          request.auth.uid < resource.data.uid
            ? request.auth.uid + '_' + resource.data.uid
            : resource.data.uid + '_' + request.auth.uid
        )).data.status == 'accepted'
      );
    }
    match /live_locations/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (resource.data.sharing == true &&
          get(/databases/$(database)/documents/friendships/$(
            request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid
          )).data.status == 'accepted') ||
        (resource.data.sharing == true &&
          resource.data.groupAdventureId != null &&
          (
            request.auth.uid == get(/databases/$(database)/documents/group_adventures/$(resource.data.groupAdventureId)).data.createdBy ||
            request.auth.uid in get(/databases/$(database)/documents/group_adventures/$(resource.data.groupAdventureId)).data.memberUids
          ))
      );
    }
    match /group_adventures/{adventureId} {
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.memberUids == [] || request.resource.data.memberUids == [request.auth.uid]);
      allow read: if request.auth != null && (
        resource.data.visibility == 'public' ||
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberUids
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) && (
          (resource.data.visibility == 'public' && request.resource.data.memberUids.removeAll(resource.data.memberUids) == [request.auth.uid]) ||
          resource.data.memberUids.removeAll(request.resource.data.memberUids) == [request.auth.uid]
        ))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/group_adventures/$(adventureId)).data.createdBy ||
          request.auth.uid in get(/databases/$(database)/documents/group_adventures/$(adventureId)).data.memberUids
        );
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (
            request.auth.uid == get(/databases/$(database)/documents/group_adventures/$(adventureId)).data.createdBy ||
            request.auth.uid in get(/databases/$(database)/documents/group_adventures/$(adventureId)).data.memberUids
          );
        // No update/delete: messages are immutable once sent — simplest
        // moderation-free MVP. Use Block/Report (above) to deal with abuse.
      }
    }
    match /groups/{groupId} {
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.memberUids == [] || request.resource.data.memberUids == [request.auth.uid]);
      allow read: if request.auth != null && (
        resource.data.visibility == 'public' ||
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.memberUids
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) && (
          (resource.data.visibility == 'public' && request.resource.data.memberUids.removeAll(resource.data.memberUids) == [request.auth.uid]) ||
          resource.data.memberUids.removeAll(request.resource.data.memberUids) == [request.auth.uid]
        ))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
        );
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (
            request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          );
      }
      match /safety_statuses/{statusUid} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
        );
        allow write: if request.auth != null
          && request.auth.uid == statusUid
          && (
            request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy ||
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          );
      }
    }
    match /location_communities/{locationId} {
      allow read: if request.auth != null;
      // Counter increments are trusted client-side beyond "only this field,
      // only by exactly 1 at a time" — there's no way to cryptographically
      // tie this write to the matching `visitors/{uid}` creation below
      // without a Cloud Function. Accepted as a low-stakes MVP tradeoff:
      // worst case someone inflates a count by a small amount, not a
      // privacy or data-integrity issue.
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['explorerCount'])
        && request.resource.data.explorerCount == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['explorerCount'])
        && request.resource.data.explorerCount == resource.data.explorerCount + 1;

      match /visitors/{visitorUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == visitorUid;
      }
      match /tips/{tipId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }
    match /explorers/{uid}/blocked/{blockedId} {
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == resource.data.blockedUid);
    }
    match /explorers/{uid}/muted/{mutedId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /footprints/{uid} {
      // Exploration footprint (route history + visited places). The owner
      // always has full access; everyone else can read it only if the doc's
      // own `visibility` allows: `public` = any signed-in user, `friends`
      // = an accepted friendship exists, `private` = owner only.
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        resource.data.visibility == 'public' ||
        (resource.data.visibility == 'friends' &&
          get(/databases/$(database)/documents/friendships/$(
            request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid
          )).data.status == 'accepted')
      );
    }
    match /shared_memories/{memoryId} {
      // Photos and videos people chose to share. Only the owner writes; others
      // read what is public, or anything from an accepted friend. (Unsharing
      // deletes the document, so a private memory never exists online.)
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visibility in ['friends', 'public'];
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visibility in ['friends', 'public'];
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.visibility == 'public' ||
        get(/databases/$(database)/documents/friendships/$(
          request.auth.uid < resource.data.uid
            ? request.auth.uid + '_' + resource.data.uid
            : resource.data.uid + '_' + request.auth.uid
        )).data.status == 'accepted'
      );
    }
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reportedBy == request.auth.uid;
      // No read rule: reports are write-only from the app's perspective —
      // not even the reporter can read them back. Review happens by an
      // admin reading the Firestore console directly; there's no
      // in-app moderator role yet.
    }

    // XP judged by the verifyTrip Cloud Function. The app can read its own
    // total but never write here: only the server (admin SDK, which bypasses
    // these rules) can add XP. The leaderboard can read any total.
    match /verified_xp/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
      match /{sub=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Saved trip itineraries (cloud backup + sharing with friends). Everyone
    // in `memberUids` can read and edit the plan; only the owner can change
    // who it's shared with or delete it; a member can remove only themselves.
    match /trip_plans/{tripId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() <= 20;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids.size() <= 20
        && (
          request.auth.uid == resource.data.ownerUid
            && request.auth.uid in request.resource.data.memberUids
          || request.resource.data.memberUids.hasOnly(resource.data.memberUids)
            && resource.data.memberUids.hasOnly(request.resource.data.memberUids)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && resource.data.memberUids.removeAll(request.resource.data.memberUids) == [request.auth.uid]
            && request.resource.data.memberUids.removeAll(resource.data.memberUids) == []
        );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    match /friend_challenges/{challengeId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.challengerUid ||
        request.auth.uid == resource.data.challengedUid
      );
      allow create: if request.auth != null && request.resource.data.challengerUid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.challengerUid ||
        request.auth.uid == resource.data.challengedUid
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.challengerUid ||
        request.auth.uid == resource.data.challengedUid
      );
    }
  }
}
